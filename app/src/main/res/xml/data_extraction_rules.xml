<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="aura_settings.xml" />
        <exclude domain="sharedpref" path="aura_secure.xml" />
        <exclude domain="file" path="sessions/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="aura_settings.xml" />
        <exclude domain="sharedpref" path="aura_secure.xml" />
    </device-transfer>
</data-extraction-rules>
