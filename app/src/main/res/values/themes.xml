<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aura" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/aura_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Aura.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aura_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_aura_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Aura</item>
    </style>
</resources>
