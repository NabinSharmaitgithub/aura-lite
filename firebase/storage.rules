rules_version = '2';

// AURA — Cloud Storage security rules
//
// AURA does not upload files today. These rules exist so that when Storage-backed sync is
// enabled later, the default is already correct: each user's uploads live under
// users/{uid}/ and only that user can read or write them, with a 10 MiB cap.
//
// Deploy with: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Everything else is denied by default.
  }
}
